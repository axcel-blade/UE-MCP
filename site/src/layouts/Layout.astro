---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Unreal Engine MCP",
  description = "An MCP server and Unreal Editor plugin that let AI assistants build and edit Unreal Engine 5 projects.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const repo = "https://github.com/axcel-blade/UE-MCP";
const docs = `${repo}/blob/develop/docs`;
const version = "1.0.4";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar">
      <a class="brand" href={`${base}/`}>
        <svg viewBox="0 0 32 32" width="22" height="22" aria-hidden="true">
          <rect width="32" height="32" rx="7" fill="currentColor"></rect>
          <path
            d="M10 9h3.2v9.2c0 2 1.1 3.1 2.8 3.1s2.8-1.1 2.8-3.1V9H22v9.4c0 3.8-2.4 5.9-6 5.9s-6-2.1-6-5.9V9Z"
            fill="var(--bg)"></path>
        </svg>
        Unreal Engine MCP
      </a>
      <nav aria-label="Main">
        <a href={`${base}/#install`}>Install</a>
        <a href={`${docs}/MCP_TOOLS.md`}>Tools</a>
        <a href={`${docs}/INSTALLATION.md`}>Docs</a>
        <a href={`${repo}/releases/latest`} class="pill">v{version}</a>
        <a href={repo} aria-label="GitHub repository">GitHub</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <span>Unreal Engine MCP v{version} · MIT License</span>
      <span>Not affiliated with Epic Games. Unreal and Unreal Engine are trademarks of Epic Games, Inc.</span>
    </footer>
  </body>
</html>
